# ===================================================
#   Shadow Assistant - Environment Configuration
# ===================================================

# N8N Webhook URL for outgoing requests (chat, translate, note, scripts)
N8N_WEBHOOK_URL=http://100.x.y.z:5678/webhook/shadow-assistant

# Port on this laptop for incoming notifications from n8n
NOTIFICATION_PORT=8080

# Tailscale IP of this laptop (set to your Tailscale 100.x.y.z IP)
TAILSCALE_IP=0.0.0.0

# Optional: Shared auth token for authenticating incoming notifications from n8n
N8N_AUTH_TOKEN=

# Optional: API key for n8n webhook authorization
N8N_API_KEY=

# Screenshot quality (1-100)
SCREENSHOT_QUALITY=70

# Interface Theme ("dark" | "light")
THEME=dark
