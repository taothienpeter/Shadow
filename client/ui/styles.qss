/* ═══════════════════════════════════════════════════════════════
   Shadow Assistant — Conversational Apple Dark Theme
   (Compact Floating Bar: Context Tags + Chat Input Capsule)
   ═══════════════════════════════════════════════════════════════ */

QDialog {
    background: transparent;
    font-family: 'Segoe UI Variable Display', 'Segoe UI', -apple-system, 'SF Pro Display', 'Inter', sans-serif;
}

/* ─── Context Tag Row ────────────────────────────────────────── */

QLabel#contextLabel {
    color: #86868B;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#actionTag {
    background: rgba(255, 255, 255, 0.05);
    color: #A1A1A6;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#actionTag:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #F5F5F7;
    border: 1px solid rgba(255, 255, 255, 0.16);
}

QPushButton#actionTag:pressed {
    background: rgba(255, 255, 255, 0.06);
}

QPushButton#pinTag {
    background: transparent;
    color: #636366;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 500;
}

QPushButton#pinTag:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #A1A1A6;
}

QPushButton#pinTag:checked {
    background: rgba(0, 113, 227, 0.20);
    color: #0A84FF;
    border: 1px solid rgba(10, 132, 255, 0.35);
}

/* ─── Chat Input Capsule ─────────────────────────────────────── */

QFrame#chatInputFrame {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 14px;
}

QLineEdit#chatInput {
    background: transparent;
    color: #FFFFFF;
    border: none;
    padding: 8px 2px;
    font-size: 14px;
    font-weight: 400;
    selection-background-color: rgba(0, 113, 227, 0.45);
}

QLineEdit#chatInput::placeholder {
    color: #636366;
    font-size: 13px;
    font-weight: 400;
}

QPushButton#chatSendBtn {
    background: rgba(255, 255, 255, 0.08);
    color: #8E8E93;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton#chatSendBtn:pressed {
    background: #0056CC;
}

QPushButton#chatScreenshotBtn {
    background: rgba(255, 255, 255, 0.06);
    color: #A1A1A6;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 5px 9px;
    font-size: 13px;
    min-height: 20px;
}

QPushButton#chatScreenshotBtn:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #0A84FF;
    border: 1px solid rgba(10, 132, 255, 0.40);
}

QPushButton#chatScreenshotBtn:pressed {
    background: rgba(10, 132, 255, 0.25);
}

/* ─── Attachment Preview Badge ───────────────────────────────── */

QFrame#attachmentFrame {
    background: rgba(10, 132, 255, 0.12);
    border: 1px solid rgba(10, 132, 255, 0.30);
    border-radius: 8px;
    padding: 2px 8px;
}

QLabel#attachmentLabel {
    color: #0A84FF;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#attachmentRemoveBtn {
    background: transparent;
    color: #8E8E93;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding: 0px 4px;
}

QPushButton#attachmentRemoveBtn:hover {
    color: #FF453A;
}