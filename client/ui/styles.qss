/* ═══════════════════════════════════════════════════════════════
   Shadow Assistant — True Apple Spotlight Theme
   Borderless hero input + Hairline divider + Minimal Action Pills
   ═══════════════════════════════════════════════════════════════ */

QDialog {
    background: transparent;
    font-family: 'Segoe UI Variable Display', 'Segoe UI', -apple-system, 'SF Pro Display', 'Inter', sans-serif;
}

/* ─── Zone 1: Spotlight Hero Input (Borderless) ─────────────── */

QLineEdit#spotlightInput {
    background: transparent;
    color: #F5F5F7;
    border: none;
    padding: 6px 0px;
    font-size: 16px;
    font-weight: 400;
    selection-background-color: rgba(0, 113, 227, 0.45);
}

QLineEdit#spotlightInput::placeholder {
    color: #636366;
    font-size: 15px;
    font-weight: 300;
}

QPushButton#sendBtn {
    background: rgba(255, 255, 255, 0.08);
    color: #A1A1A6;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 7px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
    min-height: 22px;
}

QPushButton#sendBtn:hover {
    background: #0071E3;
    color: #FFFFFF;
    border: 1px solid #0A84FF;
}

QPushButton#sendBtn:pressed {
    background: #0056CC;
}

/* ─── Hairline Divider ───────────────────────────────────────── */

QFrame#hairlineDivider {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    max-height: 1px;
}

/* ─── Zone 2: Context & Content Row ──────────────────────────── */

QLabel#contextLabel {
    color: #98989D;
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
}

QPushButton#pillBtn {
    background: rgba(255, 255, 255, 0.06);
    color: #D1D1D6;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#pillBtn:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.20);
}

QPushButton#pillBtn:pressed {
    background: rgba(255, 255, 255, 0.08);
}

/* ─── Zone 3: Footer Row ─────────────────────────────────────── */

QLabel#kbdKey {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 4px;
    color: #636366;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 5px;
}

QLabel#kbdDesc {
    color: #48484A;
    font-size: 10px;
    font-weight: 400;
}

QPushButton#pinBtn {
    background: transparent;
    color: #48484A;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 10px;
    font-weight: 500;
}

QPushButton#pinBtn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #A1A1A6;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QPushButton#pinBtn:checked {
    background: rgba(0, 113, 227, 0.15);
    color: #0A84FF;
    border: 1px solid rgba(10, 132, 255, 0.30);
}